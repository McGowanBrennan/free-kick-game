{
  "name": "free-kick-duel",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "harness"
  ],
  "scripts": {
    "harness": "npm run dev -w @fk/harness",
    "harness:lan": "npm run dev -w @fk/harness -- --host",
    "test": "vitest run",
    "typecheck": "tsc -p shared && tsc -p harness",
    "golden": "node -e \"require('fs').rmSync('shared/golden/determinism.json',{force:true})\" && vitest run determinism"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
