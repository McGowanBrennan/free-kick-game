{
  "name": "free-kick-duel",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "client",
    "harness",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev -w @fk/client",
    "dev:lan": "npm run dev -w @fk/client -- --host",
    "build": "npm run build -w @fk/client",
    "preview": "npm run preview -w @fk/client -- --host",
    "harness": "npm run dev -w @fk/harness",
    "harness:lan": "npm run dev -w @fk/harness -- --host",
    "test": "vitest run",
    "typecheck": "tsc -p shared && tsc -p client && tsc -p harness && tsc -p server",
    "golden": "node -e \"require('fs').rmSync('shared/golden/determinism.json',{force:true})\" && vitest run determinism",
    "server": "npm run dev -w @fk/server",
    "server:build": "npm run build -w @fk/server",
    "start": "npm run start -w @fk/server"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
